# Resend API key (https://resend.com -> API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Inbox that receives contact messages. With Resend's shared test sender
# (onboarding@resend.dev) this must be the email you signed up to Resend with.
CONTACT_TO_EMAIL=you@example.com
# Optional: a sender on a domain you verified in Resend
# CONTACT_FROM_EMAIL=Portfolio <hello@yourdomain.com>
# Optional: lock CORS to your site(s), comma-separated
# ALLOWED_ORIGINS=https://venupagadala.github.io,http://localhost:3000
PORT=5000
